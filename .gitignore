# Explicit, reviewed metadata JSON can be staged (never actual media or working journals).
/history-data/**
!/history-data/index.json
!/history-data/history-shards/
!/history-data/history-shards/*.json
/history-addons/**
!/history-addons/hpwren-offline-events.json
!/history-addons/hpwren-sample-frames.json
!/history-addons/uaf-video-leads.json

# Collector and validation state are private/operational, not historical index data.
/collector/
/validation-controller/
/journals/
/scan-output/
/validation-results/
/PLAYBACK_RESULTS/
/logs/
/downloads/
/archives/
/collections/
/LOOKOUT_LOCKIN_RESULTS/
/LOOKOUT_STAGE_PREP_RESULTS/
*.log
*.tmp
*.part
*.mp4
*.mpg
*.mov
*.webm
*.avi
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.zip
.env
.env.*
!.env.example
**/__pycache__/
.pytest_cache/
.venv/
.DS_Store
